{
  "sourceLanguage": "en",
  "strings": {
    "exercise.back-extension.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position yourself face down on the bench with your hips on the pad and ankles secured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócate boca abajo en el banco con la cadera sobre el cojín y los tobillos asegurados."
          }
        }
      }
    },
    "exercise.back-extension.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your torso toward the floor by hinging at the hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el torso hacia el suelo flexionando desde la cadera."
          }
        }
      }
    },
    "exercise.back-extension.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise your torso until your body forms a straight line — don't hyperextend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva el torso hasta que el cuerpo forme una línea recta, sin hiperextender."
          }
        }
      }
    },
    "exercise.back-extension.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower back down with control and repeat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja de nuevo con control y repite."
          }
        }
      }
    },
    "exercise.back-extension.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raising the torso from a bent position on a hyperextension bench. It strengthens the lower back, with glutes and hamstrings assisting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevar el torso desde una posición flexionada en un banco de hiperextensiones. Fortalece la zona lumbar, con ayuda de glúteos e isquiotibiales."
          }
        }
      }
    },
    "exercise.barbell-curl.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand holding the bar with an underhand grip at shoulder width, arms extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate sosteniendo la barra con agarre supino al ancho de hombros y los brazos extendidos."
          }
        }
      }
    },
    "exercise.barbell-curl.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl the bar up toward your shoulders, keeping your elbows pinned at your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la barra hacia los hombros manteniendo los codos fijos a los costados."
          }
        }
      }
    },
    "exercise.barbell-curl.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your biceps at the top of the movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrae los bíceps en la parte alta del movimiento."
          }
        }
      }
    },
    "exercise.barbell-curl.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the bar slowly until your arms are fully extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la barra lentamente hasta extender los brazos por completo."
          }
        }
      }
    },
    "exercise.barbell-curl.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The standing barbell curl, flexing the elbows to lift the bar from the thighs to the shoulders. The classic mass builder for the biceps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El curl de pie con barra, flexionando los codos para llevar la barra de los muslos a los hombros. El ejercicio clásico para dar volumen a los bíceps."
          }
        }
      }
    },
    "exercise.barbell-row.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinge at the hips with a flat back until your torso is close to parallel with the floor, holding the bar with an overhand grip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclina el torso desde la cadera con la espalda recta hasta quedar casi paralelo al suelo, sosteniendo la barra con agarre prono."
          }
        }
      }
    },
    "exercise.barbell-row.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Row the bar to your lower ribs, driving your elbows behind you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rema la barra hacia las costillas inferiores, llevando los codos hacia atrás."
          }
        }
      }
    },
    "exercise.barbell-row.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your shoulder blades together at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta los omóplatos en la parte alta del movimiento."
          }
        }
      }
    },
    "exercise.barbell-row.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the bar under control until your arms are extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la barra de forma controlada hasta extender los brazos."
          }
        }
      }
    },
    "exercise.barbell-row.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bent-over pull rowing a barbell to the torso. It builds thickness across the whole back and reinforces hip-hinge strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remo con barra con el torso inclinado. Desarrolla el grosor de toda la espalda y refuerza la fuerza en la bisagra de cadera."
          }
        }
      }
    },
    "exercise.bench-press.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on a flat bench with your feet planted on the floor and your eyes under the bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate en un banco plano con los pies apoyados en el suelo y los ojos debajo de la barra."
          }
        }
      }
    },
    "exercise.bench-press.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip the bar slightly wider than shoulder width and unrack it over your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta la barra con un agarre un poco más ancho que los hombros y sácala del soporte sobre tu pecho."
          }
        }
      }
    },
    "exercise.bench-press.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the bar under control until it touches your mid-chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la barra de forma controlada hasta que toque la parte media del pecho."
          }
        }
      }
    },
    "exercise.bench-press.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the bar back up until your arms are fully extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja la barra hacia arriba hasta extender los brazos por completo."
          }
        }
      }
    },
    "exercise.bench-press.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The classic barbell press performed lying on a flat bench. It builds the chest, with the triceps and front shoulders assisting the press."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El press clásico con barra realizado acostado en un banco plano. Desarrolla el pecho, con ayuda de los tríceps y la parte frontal de los hombros."
          }
        }
      }
    },
    "exercise.cable-crossover.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set both pulleys high, grab a handle in each hand, and step forward into a staggered stance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca ambas poleas en alto, toma una manija en cada mano y da un paso al frente con una pierna adelantada."
          }
        }
      }
    },
    "exercise.cable-crossover.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a slight bend in your elbows, pull the handles down and together in front of your hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con los codos ligeramente flexionados, lleva las manijas hacia abajo y júntalas frente a las caderas."
          }
        }
      }
    },
    "exercise.cable-crossover.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your chest at the point where your hands meet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrae el pecho en el punto donde se juntan las manos."
          }
        }
      }
    },
    "exercise.cable-crossover.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return your arms slowly to the stretched starting position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regresa los brazos lentamente a la posición inicial de estiramiento."
          }
        }
      }
    },
    "exercise.cable-crossover.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cable isolation exercise pulling both handles from high pulleys down and across the body. Constant cable tension targets the chest through its full range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ejercicio de aislamiento en polea que lleva ambas manijas desde arriba hacia abajo y al centro del cuerpo. La tensión constante del cable trabaja el pecho en todo su recorrido."
          }
        }
      }
    },
    "exercise.calf-raise.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with the balls of your feet on an edge or platform, heels hanging off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate con la punta de los pies en un borde o plataforma, con los talones en el aire."
          }
        }
      }
    },
    "exercise.calf-raise.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise as high as you can onto your toes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elévate lo más alto posible sobre la punta de los pies."
          }
        }
      }
    },
    "exercise.calf-raise.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause briefly at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pausa breve arriba."
          }
        }
      }
    },
    "exercise.calf-raise.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your heels below the edge until you feel a stretch in your calves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja los talones por debajo del borde hasta sentir el estiramiento en las pantorrillas."
          }
        }
      }
    },
    "exercise.calf-raise.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rising onto the balls of the feet and lowering back down, standing or on a machine. The standard movement for building the calves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevarse sobre la punta de los pies y volver a bajar, de pie o en máquina. El movimiento estándar para desarrollar las pantorrillas."
          }
        }
      }
    },
    "exercise.crunch.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back with your knees bent and feet flat on the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate boca arriba con las rodillas flexionadas y los pies apoyados en el suelo."
          }
        }
      }
    },
    "exercise.crunch.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your hands behind your head or across your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca las manos detrás de la cabeza o cruzadas sobre el pecho."
          }
        }
      }
    },
    "exercise.crunch.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl your shoulders off the floor by contracting your abs, without pulling on your neck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despega los hombros del suelo contrayendo el abdomen, sin jalar el cuello."
          }
        }
      }
    },
    "exercise.crunch.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower back down slowly to the starting position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja lentamente hasta la posición inicial."
          }
        }
      }
    },
    "exercise.crunch.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curling the shoulders off the floor toward the pelvis while lying on the back. A short-range flexion that targets the abs directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevar los hombros del suelo hacia la pelvis acostado boca arriba. Una flexión de recorrido corto que trabaja directamente el abdomen."
          }
        }
      }
    },
    "exercise.deadlift.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with the bar over mid-foot and grip it just outside your legs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate con la barra sobre la mitad del pie y sujétala justo por fuera de las piernas."
          }
        }
      }
    },
    "exercise.deadlift.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a flat back with your hips down and chest up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la espalda recta con la cadera abajo y el pecho arriba."
          }
        }
      }
    },
    "exercise.deadlift.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive through your legs and stand up, keeping the bar close to your body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja con las piernas y ponte de pie, manteniendo la barra pegada al cuerpo."
          }
        }
      }
    },
    "exercise.deadlift.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock out your hips at the top, then lower the bar back to the floor with control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende la cadera por completo arriba y luego baja la barra al suelo con control."
          }
        }
      }
    },
    "exercise.deadlift.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifting a loaded barbell from the floor to a standing position. The heaviest full-body pull, driven by the back, hamstrings, and glutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar una barra cargada desde el suelo hasta quedar de pie. El tirón más pesado para todo el cuerpo, impulsado por la espalda, los isquiotibiales y los glúteos."
          }
        }
      }
    },
    "exercise.dip.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support yourself on parallel bars with your arms locked and body upright."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostente en las barras paralelas con los brazos extendidos y el cuerpo erguido."
          }
        }
      }
    },
    "exercise.dip.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your body by bending your elbows until your upper arms are about parallel with the bars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el cuerpo flexionando los codos hasta que los brazos queden casi paralelos a las barras."
          }
        }
      }
    },
    "exercise.dip.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your torso upright to emphasize the triceps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el torso erguido para enfatizar los tríceps."
          }
        }
      }
    },
    "exercise.dip.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press back up until your arms are fully extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja hacia arriba hasta extender los brazos por completo."
          }
        }
      }
    },
    "exercise.dip.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowering and pressing the body between parallel bars. A heavy bodyweight push that loads the triceps, with the chest and shoulders assisting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar y empujar el cuerpo entre barras paralelas. Un empuje exigente con el peso corporal que carga los tríceps, con ayuda del pecho y los hombros."
          }
        }
      }
    },
    "exercise.dumbbell-curl.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with a dumbbell in each hand, arms at your sides and palms facing forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate con una mancuerna en cada mano, los brazos a los costados y las palmas hacia el frente."
          }
        }
      }
    },
    "exercise.dumbbell-curl.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl the dumbbells toward your shoulders, keeping your elbows at your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las mancuernas hacia los hombros manteniendo los codos pegados a los costados."
          }
        }
      }
    },
    "exercise.dumbbell-curl.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze at the top, then lower the weights slowly until your arms are extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrae arriba y luego baja el peso lentamente hasta extender los brazos."
          }
        }
      }
    },
    "exercise.dumbbell-curl.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curling dumbbells one in each hand, with a palms-up grip. The independent arms allow a natural wrist path and even biceps development."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl con una mancuerna en cada mano, con las palmas hacia arriba. Trabajar cada brazo por separado permite un recorrido natural de la muñeca y un desarrollo parejo de los bíceps."
          }
        }
      }
    },
    "exercise.dumbbell-fly.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on a flat bench holding a dumbbell in each hand above your chest, palms facing each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate en un banco plano sosteniendo una mancuerna en cada mano sobre el pecho, con las palmas enfrentadas."
          }
        }
      }
    },
    "exercise.dumbbell-fly.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a slight bend in your elbows, open your arms in a wide arc until you feel a stretch in your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con los codos ligeramente flexionados, abre los brazos en un arco amplio hasta sentir un estiramiento en el pecho."
          }
        }
      }
    },
    "exercise.dumbbell-fly.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the dumbbells back together above your chest along the same arc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a juntar las mancuernas sobre el pecho siguiendo el mismo arco."
          }
        }
      }
    },
    "exercise.dumbbell-fly.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the elbow angle constant throughout; only the shoulders move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el ángulo de los codos constante durante todo el movimiento; solo se mueven los hombros."
          }
        }
      }
    },
    "exercise.dumbbell-fly.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An isolation movement lying on a bench, opening and closing the arms in a wide arc with dumbbells. It stretches and squeezes the chest without heavy pressing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ejercicio de aislamiento acostado en un banco, abriendo y cerrando los brazos en un arco amplio con mancuernas. Estira y contrae el pecho sin un press pesado."
          }
        }
      }
    },
    "exercise.elliptical.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step onto the pedals and grab the moving handles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbete a los pedales y sujeta las manijas móviles."
          }
        }
      }
    },
    "exercise.elliptical.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start striding at an easy pace to find your rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza a moverte a un ritmo suave hasta encontrar tu cadencia."
          }
        }
      }
    },
    "exercise.elliptical.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the resistance to your working effort, pushing and pulling with your arms as you stride."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la resistencia hasta tu nivel de esfuerzo, empujando y jalando con los brazos al ritmo de las piernas."
          }
        }
      }
    },
    "exercise.elliptical.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain the pace for the planned time, then cool down slowly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el ritmo durante el tiempo previsto y termina disminuyendo lentamente."
          }
        }
      }
    },
    "exercise.elliptical.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Striding on an elliptical trainer with moving handles. Smooth, low-impact cardio that involves both legs and arms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zancadas en una máquina elíptica con manijas móviles. Cardio suave y de bajo impacto que involucra piernas y brazos."
          }
        }
      }
    },
    "exercise.face-pull.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a rope attachment at face height and grab both ends with an overhand grip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca la cuerda a la altura de la cara y toma ambos extremos con agarre prono."
          }
        }
      }
    },
    "exercise.face-pull.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the rope toward your face, spreading the ends apart as your hands reach your ears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jala la cuerda hacia la cara, separando los extremos cuando las manos lleguen a las orejas."
          }
        }
      }
    },
    "exercise.face-pull.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your rear shoulders and upper back at the end of the pull."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrae la parte posterior de los hombros y la espalda alta al final del jalón."
          }
        }
      }
    },
    "exercise.face-pull.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return your arms slowly to the extended starting position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regresa los brazos lentamente a la posición inicial extendida."
          }
        }
      }
    },
    "exercise.face-pull.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulling a rope attachment toward the face on a high cable. It strengthens the rear shoulders and upper back, key for posture and shoulder health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalar una cuerda hacia la cara en una polea alta. Fortalece la parte posterior de los hombros y la espalda alta, clave para la postura y la salud del hombro."
          }
        }
      }
    },
    "exercise.front-raise.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand holding dumbbells in front of your thighs, palms facing your body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate sosteniendo mancuernas frente a los muslos, con las palmas hacia el cuerpo."
          }
        }
      }
    },
    "exercise.front-raise.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise one or both arms straight forward until they reach shoulder height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva uno o ambos brazos al frente hasta la altura de los hombros."
          }
        }
      }
    },
    "exercise.front-raise.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a slight bend in your elbows and avoid swinging your torso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén los codos ligeramente flexionados y evita balancear el torso."
          }
        }
      }
    },
    "exercise.front-raise.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the weight slowly back to the starting position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el peso lentamente hasta la posición inicial."
          }
        }
      }
    },
    "exercise.front-raise.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifting dumbbells straight out in front to shoulder height. It isolates the front head of the shoulder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevar mancuernas al frente hasta la altura de los hombros. Aísla la cabeza frontal del hombro."
          }
        }
      }
    },
    "exercise.front-squat.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rack the bar on your front shoulders with your elbows lifted high."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya la barra en la parte frontal de los hombros con los codos bien elevados."
          }
        }
      }
    },
    "exercise.front-squat.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat down keeping your torso as upright as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja en sentadilla manteniendo el torso lo más erguido posible."
          }
        }
      }
    },
    "exercise.front-squat.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend until your thighs are at least parallel with the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desciende hasta que los muslos queden al menos paralelos al suelo."
          }
        }
      }
    },
    "exercise.front-squat.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive back up while keeping your elbows high so the bar stays racked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube empujando con las piernas y mantén los codos altos para que la barra no se deslice."
          }
        }
      }
    },
    "exercise.front-squat.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A squat with the barbell racked on the front shoulders. The upright torso keeps tension on the quads and demands a strong core."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sentadilla con la barra apoyada en la parte frontal de los hombros. El torso erguido mantiene la tensión en los cuádriceps y exige un core fuerte."
          }
        }
      }
    },
    "exercise.hammer-curl.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with a dumbbell in each hand, palms facing your body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate con una mancuerna en cada mano y las palmas hacia el cuerpo."
          }
        }
      }
    },
    "exercise.hammer-curl.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl the dumbbells up while keeping the neutral grip, like swinging a hammer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube las mancuernas manteniendo el agarre neutro, como si movieras un martillo."
          }
        }
      }
    },
    "exercise.hammer-curl.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows pinned at your sides throughout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén los codos fijos a los costados durante todo el movimiento."
          }
        }
      }
    },
    "exercise.hammer-curl.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the weights slowly back to the starting position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el peso lentamente hasta la posición inicial."
          }
        }
      }
    },
    "exercise.hammer-curl.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dumbbell curl performed with a neutral, thumbs-up grip. It shifts emphasis to the brachialis and forearms for thicker-looking arms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un curl con mancuernas con agarre neutro, con los pulgares hacia arriba. Traslada el énfasis al braquial y a los antebrazos para unos brazos de aspecto más grueso."
          }
        }
      }
    },
    "exercise.hip-thrust.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit on the floor with your upper back against a bench and the bar over your hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en el suelo con la espalda alta apoyada en un banco y la barra sobre la cadera."
          }
        }
      }
    },
    "exercise.hip-thrust.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant your feet flat, about hip-width apart, close to your glutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya los pies planos, al ancho de cadera, cerca de los glúteos."
          }
        }
      }
    },
    "exercise.hip-thrust.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive through your heels and lift your hips until your torso is parallel with the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja con los talones y eleva la cadera hasta que el torso quede paralelo al suelo."
          }
        }
      }
    },
    "exercise.hip-thrust.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your glutes at the top, then lower your hips with control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrae los glúteos arriba y baja la cadera con control."
          }
        }
      }
    },
    "exercise.hip-thrust.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Driving the hips upward with the upper back resting on a bench and a barbell across the hips. The most direct heavy loader for the glutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empujar la cadera hacia arriba con la espalda alta apoyada en un banco y una barra sobre la cadera. La forma más directa de cargar los glúteos con peso."
          }
        }
      }
    },
    "exercise.incline-bench-press.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the bench to a 30–45° incline and lie back with your feet on the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el banco a una inclinación de 30–45° y recuéstate con los pies en el suelo."
          }
        }
      }
    },
    "exercise.incline-bench-press.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip the bar slightly wider than shoulder width and unrack it over your upper chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta la barra un poco más ancho que los hombros y sácala del soporte sobre la parte alta del pecho."
          }
        }
      }
    },
    "exercise.incline-bench-press.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the bar under control to your upper chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la barra de forma controlada hasta la parte alta del pecho."
          }
        }
      }
    },
    "exercise.incline-bench-press.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the bar back up until your arms are fully extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja la barra hacia arriba hasta extender los brazos por completo."
          }
        }
      }
    },
    "exercise.incline-bench-press.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A barbell press on a bench set to a 30–45° incline. The angle shifts the work toward the upper chest and front shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un press con barra en un banco inclinado a 30–45°. El ángulo dirige el trabajo hacia la parte superior del pecho y el frente de los hombros."
          }
        }
      }
    },
    "exercise.jump-rope.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a handle in each hand with the rope behind your heels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén una manija en cada mano con la cuerda detrás de los talones."
          }
        }
      }
    },
    "exercise.jump-rope.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swing the rope overhead and jump just high enough for it to pass under your feet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la cuerda por encima de la cabeza y salta apenas lo suficiente para que pase bajo los pies."
          }
        }
      }
    },
    "exercise.jump-rope.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land softly on the balls of your feet with relaxed knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterriza suave sobre la punta de los pies con las rodillas relajadas."
          }
        }
      }
    },
    "exercise.jump-rope.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the rope with your wrists, not your arms, and keep a steady rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la cuerda con las muñecas, no con los brazos, y mantén un ritmo constante."
          }
        }
      }
    },
    "exercise.jump-rope.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuous jumping over a turning rope. Simple, intense cardio that builds footwork, coordination, and calf endurance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltos continuos sobre una cuerda que gira. Cardio simple e intenso que desarrolla el juego de pies, la coordinación y la resistencia de las pantorrillas."
          }
        }
      }
    },
    "exercise.lat-pulldown.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit at the machine with your thighs secured under the pads and grip the bar wider than shoulder width."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en la máquina con los muslos asegurados bajo las almohadillas y sujeta la barra más ancho que los hombros."
          }
        }
      }
    },
    "exercise.lat-pulldown.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the bar down to your upper chest, driving your elbows down and back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jala la barra hasta la parte alta del pecho, llevando los codos hacia abajo y atrás."
          }
        }
      }
    },
    "exercise.lat-pulldown.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your shoulder blades together at the bottom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta los omóplatos al final del movimiento."
          }
        }
      }
    },
    "exercise.lat-pulldown.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the bar rise slowly until your arms are fully extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja subir la barra lentamente hasta extender los brazos por completo."
          }
        }
      }
    },
    "exercise.lat-pulldown.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A machine pull that brings a wide bar down to the upper chest while seated. It trains the same pattern as a pull-up with adjustable load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jalón en máquina que lleva una barra ancha hacia la parte alta del pecho estando sentado. Entrena el mismo patrón que la dominada con carga ajustable."
          }
        }
      }
    },
    "exercise.lateral-raise.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand holding a dumbbell in each hand at your sides with a slight bend in your elbows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate con una mancuerna en cada mano a los costados, con los codos ligeramente flexionados."
          }
        }
      }
    },
    "exercise.lateral-raise.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise your arms out to the sides until they are about parallel with the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva los brazos hacia los lados hasta que queden aproximadamente paralelos al suelo."
          }
        }
      }
    },
    "exercise.lateral-raise.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause briefly at the top without shrugging your shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pausa breve arriba sin encoger los hombros."
          }
        }
      }
    },
    "exercise.lateral-raise.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the dumbbells slowly back to your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja las mancuernas lentamente a los costados."
          }
        }
      }
    },
    "exercise.lateral-raise.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raising light dumbbells out to the sides until the arms are parallel with the floor. The key isolation move for wider shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevar mancuernas ligeras hacia los lados hasta que los brazos queden paralelos al suelo. El ejercicio de aislamiento clave para unos hombros más anchos."
          }
        }
      }
    },
    "exercise.leg-curl.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position yourself in the machine with the pad against the back of your ankles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócate en la máquina con el rodillo contra la parte posterior de los tobillos."
          }
        }
      }
    },
    "exercise.leg-curl.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl your heels toward your glutes as far as you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva los talones hacia los glúteos tan lejos como puedas."
          }
        }
      }
    },
    "exercise.leg-curl.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the contraction briefly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la contracción un momento."
          }
        }
      }
    },
    "exercise.leg-curl.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return the weight slowly to the extended position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regresa el peso lentamente a la posición extendida."
          }
        }
      }
    },
    "exercise.leg-curl.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curling the heels toward the glutes against a padded lever in a machine. Direct isolation for the hamstrings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevar los talones hacia los glúteos contra un rodillo acolchado en una máquina. Aislamiento directo para los isquiotibiales."
          }
        }
      }
    },
    "exercise.leg-extension.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit in the machine with the pad resting on your shins just above your ankles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en la máquina con el rodillo sobre las espinillas, justo arriba de los tobillos."
          }
        }
      }
    },
    "exercise.leg-extension.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your knees until your legs are straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende las rodillas hasta que las piernas queden rectas."
          }
        }
      }
    },
    "exercise.leg-extension.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your quads briefly at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrae los cuádriceps un momento en la parte alta."
          }
        }
      }
    },
    "exercise.leg-extension.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the weight slowly back to the starting position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el peso lentamente hasta la posición inicial."
          }
        }
      }
    },
    "exercise.leg-extension.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extending the knees against a padded lever while seated in a machine. Pure isolation for the quadriceps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extender las rodillas contra un rodillo acolchado sentado en una máquina. Aislamiento puro para los cuádriceps."
          }
        }
      }
    },
    "exercise.leg-press.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit in the machine with your feet on the platform about shoulder-width apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en la máquina con los pies en la plataforma, aproximadamente al ancho de hombros."
          }
        }
      }
    },
    "exercise.leg-press.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the safeties and lower the platform until your knees approach your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera los seguros y baja la plataforma hasta que las rodillas se acerquen al pecho."
          }
        }
      }
    },
    "exercise.leg-press.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the platform away until your legs are extended without locking your knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja la plataforma hasta extender las piernas sin bloquear las rodillas."
          }
        }
      }
    },
    "exercise.leg-press.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your lower back against the pad throughout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la zona lumbar apoyada en el respaldo todo el tiempo."
          }
        }
      }
    },
    "exercise.leg-press.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressing a weighted sled away with the legs while seated in a machine. It loads the quads and glutes heavily without balancing a barbell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empujar una plataforma con peso usando las piernas, sentado en una máquina. Carga intensamente cuádriceps y glúteos sin tener que equilibrar una barra."
          }
        }
      }
    },
    "exercise.lunge.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall, then take a long step forward with one leg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate erguido y da un paso largo al frente con una pierna."
          }
        }
      }
    },
    "exercise.lunge.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your back knee toward the floor until both knees are bent about 90°."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la rodilla trasera hacia el suelo hasta que ambas rodillas queden flexionadas unos 90°."
          }
        }
      }
    },
    "exercise.lunge.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your torso upright and your front heel planted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el torso erguido y el talón delantero apoyado."
          }
        }
      }
    },
    "exercise.lunge.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push through the front foot to return to standing, then alternate legs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja con el pie delantero para volver a la posición inicial y alterna las piernas."
          }
        }
      }
    },
    "exercise.lunge.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepping forward into a split stance and lowering the back knee toward the floor. It trains each leg independently, hitting quads and glutes while challenging balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar un paso al frente y bajar la rodilla trasera hacia el suelo. Trabaja cada pierna por separado, exigiendo cuádriceps y glúteos mientras desafía el equilibrio."
          }
        }
      }
    },
    "exercise.overhead-press.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with the bar resting on your front shoulders, hands just outside shoulder width."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate con la barra apoyada en la parte frontal de los hombros, con las manos justo por fuera del ancho de hombros."
          }
        }
      }
    },
    "exercise.overhead-press.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your core and press the bar straight up past your face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprieta el core y empuja la barra en línea recta hacia arriba, pasando la cara."
          }
        }
      }
    },
    "exercise.overhead-press.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock out your arms overhead with the bar over your mid-foot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende los brazos por completo arriba, con la barra alineada sobre la mitad del pie."
          }
        }
      }
    },
    "exercise.overhead-press.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the bar under control back to your shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la barra con control de regreso a los hombros."
          }
        }
      }
    },
    "exercise.overhead-press.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressing a barbell from the shoulders to overhead while standing. The core strength lift for the shoulders, with the triceps finishing the press."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empujar una barra desde los hombros hasta arriba de la cabeza estando de pie. El levantamiento básico de fuerza para los hombros, con los tríceps completando el empuje."
          }
        }
      }
    },
    "exercise.plank.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest on your forearms and toes with your elbows under your shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apóyate en los antebrazos y en la punta de los pies, con los codos bajo los hombros."
          }
        }
      }
    },
    "exercise.plank.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form a straight line from head to heels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma una línea recta de la cabeza a los talones."
          }
        }
      }
    },
    "exercise.plank.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your abs and squeeze your glutes; don't let your hips sag or rise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprieta el abdomen y los glúteos; no dejes que la cadera caiga ni se eleve."
          }
        }
      }
    },
    "exercise.plank.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the position while breathing steadily for the target time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la posición respirando de forma constante durante el tiempo objetivo."
          }
        }
      }
    },
    "exercise.plank.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding a rigid straight-body position on the forearms and toes. An isometric staple that builds core endurance and stability."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el cuerpo rígido y recto apoyado en antebrazos y puntas de los pies. Un ejercicio isométrico básico que desarrolla resistencia y estabilidad del core."
          }
        }
      }
    },
    "exercise.pull-up.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hang from a bar with an overhand grip slightly wider than shoulder width."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuélgate de una barra con agarre prono, un poco más ancho que los hombros."
          }
        }
      }
    },
    "exercise.pull-up.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull your chest toward the bar by driving your elbows down and back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el pecho hacia la barra empujando los codos hacia abajo y atrás."
          }
        }
      }
    },
    "exercise.pull-up.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise until your chin clears the bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube hasta que la barbilla supere la barra."
          }
        }
      }
    },
    "exercise.pull-up.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower yourself under control to a full hang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja de forma controlada hasta quedar completamente colgado."
          }
        }
      }
    },
    "exercise.pull-up.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bodyweight pull hanging from an overhead bar with an overhand grip. It is the benchmark builder for the lats and upper back, with strong biceps involvement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dominada con el peso corporal colgando de una barra con agarre prono. Es el ejercicio de referencia para los dorsales y la espalda alta, con gran participación de los bíceps."
          }
        }
      }
    },
    "exercise.push-up.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start in a plank with your hands slightly wider than shoulder width and your body in a straight line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza en plancha con las manos un poco más anchas que los hombros y el cuerpo en línea recta."
          }
        }
      }
    },
    "exercise.push-up.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your chest toward the floor by bending your elbows, keeping them at about 45° from your torso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el pecho hacia el suelo flexionando los codos, manteniéndolos a unos 45° del torso."
          }
        }
      }
    },
    "exercise.push-up.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop just above the floor, then press back up to the starting position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detente justo antes de tocar el suelo y empuja hacia arriba hasta la posición inicial."
          }
        }
      }
    },
    "exercise.push-up.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your hips level and your core braced the whole time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén las caderas alineadas y el core firme todo el tiempo."
          }
        }
      }
    },
    "exercise.push-up.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fundamental bodyweight press from a plank position. It trains the chest, triceps, and shoulders while the core holds the body rigid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El press fundamental con el peso corporal desde una posición de plancha. Trabaja el pecho, los tríceps y los hombros mientras el core mantiene el cuerpo rígido."
          }
        }
      }
    },
    "exercise.romanian-deadlift.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand holding the bar at your thighs with knees slightly bent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate sosteniendo la barra frente a los muslos con las rodillas ligeramente flexionadas."
          }
        }
      }
    },
    "exercise.romanian-deadlift.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push your hips back and lower the bar along your legs, keeping your back flat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la cadera hacia atrás y baja la barra pegada a las piernas, con la espalda recta."
          }
        }
      }
    },
    "exercise.romanian-deadlift.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend until you feel a deep stretch in your hamstrings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desciende hasta sentir un estiramiento profundo en los isquiotibiales."
          }
        }
      }
    },
    "exercise.romanian-deadlift.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive your hips forward to return to standing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja la cadera hacia adelante para volver a la posición erguida."
          }
        }
      }
    },
    "exercise.romanian-deadlift.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hip hinge lowering the bar down the thighs with knees only slightly bent. It stretches and strengthens the hamstrings and glutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bisagra de cadera bajando la barra a lo largo de los muslos con las rodillas apenas flexionadas. Estira y fortalece isquiotibiales y glúteos."
          }
        }
      }
    },
    "exercise.rowing-machine.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strap in your feet and grab the handle with both hands, arms extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegura los pies y toma la manija con ambas manos, con los brazos extendidos."
          }
        }
      }
    },
    "exercise.rowing-machine.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive by extending your legs first, then lean back slightly and pull the handle to your ribs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja extendiendo primero las piernas, luego inclina el torso ligeramente hacia atrás y jala la manija hacia las costillas."
          }
        }
      }
    },
    "exercise.rowing-machine.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return in reverse order: extend your arms, lean forward, then bend your knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regresa en orden inverso: extiende los brazos, inclínate hacia adelante y flexiona las rodillas."
          }
        }
      }
    },
    "exercise.rowing-machine.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the strokes smooth and continuous for the planned time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén las remadas suaves y continuas durante el tiempo previsto."
          }
        }
      }
    },
    "exercise.rowing-machine.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rowing on an ergometer: drive with the legs, then swing the torso and pull with the arms. Cardio that works nearly the whole body, especially the back and legs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remar en un ergómetro: empuje con las piernas, balanceo del torso y jalón con los brazos. Cardio que trabaja casi todo el cuerpo, en especial espalda y piernas."
          }
        }
      }
    },
    "exercise.russian-twist.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit on the floor, lean back slightly, and lift your feet with knees bent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate en el suelo, inclínate ligeramente hacia atrás y eleva los pies con las rodillas flexionadas."
          }
        }
      }
    },
    "exercise.russian-twist.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your hands or a weight in front of your chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén las manos o un peso frente al pecho."
          }
        }
      }
    },
    "exercise.russian-twist.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate your torso to one side until your hands approach the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rota el torso hacia un lado hasta que las manos se acerquen al suelo."
          }
        }
      }
    },
    "exercise.russian-twist.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate to the other side in a controlled rhythm; each side counts as one twist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rota hacia el otro lado con un ritmo controlado; cada lado cuenta como un giro."
          }
        }
      }
    },
    "exercise.russian-twist.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotating the torso side to side while seated with the feet raised, often holding a weight. It targets the obliques through controlled rotation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotar el torso de lado a lado sentado con los pies elevados, generalmente sosteniendo un peso. Trabaja los oblicuos mediante una rotación controlada."
          }
        }
      }
    },
    "exercise.seated-cable-row.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with your feet on the platform, knees slightly bent, and grab the handle with both hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate con los pies en la plataforma, las rodillas ligeramente flexionadas, y toma la manija con ambas manos."
          }
        }
      }
    },
    "exercise.seated-cable-row.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the handle to your stomach while keeping your torso upright."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jala la manija hacia el abdomen manteniendo el torso erguido."
          }
        }
      }
    },
    "exercise.seated-cable-row.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your shoulder blades together, then let the handle return slowly until your arms are extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta los omóplatos y luego deja regresar la manija lentamente hasta extender los brazos."
          }
        }
      }
    },
    "exercise.seated-cable-row.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A seated horizontal pull on a cable machine. The supported position lets you focus on squeezing the mid-back through a long range of motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remo horizontal sentado en máquina de polea. La posición con apoyo permite concentrarse en contraer la parte media de la espalda en un recorrido amplio."
          }
        }
      }
    },
    "exercise.shrug.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall holding the weight with your arms hanging at your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Párate erguido sosteniendo el peso con los brazos extendidos a los costados."
          }
        }
      }
    },
    "exercise.shrug.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise your shoulders straight up toward your ears as high as you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva los hombros en línea recta hacia las orejas tan alto como puedas."
          }
        }
      }
    },
    "exercise.shrug.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the squeeze briefly at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la contracción un momento en la parte alta."
          }
        }
      }
    },
    "exercise.shrug.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your shoulders slowly back down; keep your arms straight throughout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja los hombros lentamente; mantén los brazos rectos todo el tiempo."
          }
        }
      }
    },
    "exercise.shrug.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raising the shoulders straight up while holding a barbell or dumbbells. A simple isolation movement for the upper traps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevar los hombros en línea recta sosteniendo una barra o mancuernas. Un ejercicio simple de aislamiento para la parte superior del trapecio."
          }
        }
      }
    },
    "exercise.skull-crusher.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on a bench holding the weight above your chest with arms extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate en un banco sosteniendo el peso sobre el pecho con los brazos extendidos."
          }
        }
      }
    },
    "exercise.skull-crusher.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your elbows to lower the weight toward your forehead, keeping your upper arms still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexiona los codos para bajar el peso hacia la frente, manteniendo los brazos inmóviles."
          }
        }
      }
    },
    "exercise.skull-crusher.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop just above your forehead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detente justo antes de tocar la frente."
          }
        }
      }
    },
    "exercise.skull-crusher.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your elbows to press the weight back to the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende los codos para regresar el peso a la posición inicial."
          }
        }
      }
    },
    "exercise.skull-crusher.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying on a bench and lowering a bar or dumbbells toward the forehead by bending only the elbows. A focused stretch-and-extend movement for the triceps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado en un banco, bajar una barra o mancuernas hacia la frente flexionando solo los codos. Un movimiento de estiramiento y extensión centrado en los tríceps."
          }
        }
      }
    },
    "exercise.squat.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest the bar on your upper back and stand with your feet about shoulder-width apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya la barra en la parte alta de la espalda y párate con los pies aproximadamente al ancho de hombros."
          }
        }
      }
    },
    "exercise.squat.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brace your core and sit down by bending your hips and knees together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprieta el core y baja flexionando caderas y rodillas a la vez."
          }
        }
      }
    },
    "exercise.squat.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend until your thighs are at least parallel with the floor, keeping your heels down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desciende hasta que los muslos queden al menos paralelos al suelo, sin levantar los talones."
          }
        }
      }
    },
    "exercise.squat.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive back up through your whole foot to a full stand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja hacia arriba con todo el pie hasta quedar completamente de pie."
          }
        }
      }
    },
    "exercise.squat.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The barbell back squat: bending hips and knees to lower into a deep seat, then standing back up. The foundational lift for the quads, glutes, and overall leg strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sentadilla trasera con barra: flexionar caderas y rodillas para bajar profundo y volver a ponerse de pie. El levantamiento fundamental para cuádriceps, glúteos y la fuerza general de las piernas."
          }
        }
      }
    },
    "exercise.stair-climber.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step onto the machine and start at a slow climbing pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbete a la máquina y comienza a un ritmo lento."
          }
        }
      }
    },
    "exercise.stair-climber.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand tall and rest your hands lightly on the rails without leaning on them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente erguido y apoya las manos ligeramente en los pasamanos sin recargarte."
          }
        }
      }
    },
    "exercise.stair-climber.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step fully onto each stair, driving through your whole foot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisa cada escalón por completo, empujando con todo el pie."
          }
        }
      }
    },
    "exercise.stair-climber.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your working pace for the planned time, then slow down to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu ritmo de trabajo durante el tiempo previsto y baja la velocidad para terminar."
          }
        }
      }
    },
    "exercise.stair-climber.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Climbing continuously on a rotating stair machine. Cardio with a strength bias toward the quads, glutes, and calves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subir de forma continua en una máquina de escaleras giratorias. Cardio con un componente de fuerza para cuádriceps, glúteos y pantorrillas."
          }
        }
      }
    },
    "exercise.stationary-bike.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat so your knee stays slightly bent at the bottom of the pedal stroke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el asiento para que la rodilla quede ligeramente flexionada en el punto más bajo del pedaleo."
          }
        }
      }
    },
    "exercise.stationary-bike.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start pedaling at an easy resistance to warm up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza a pedalear con una resistencia suave para calentar."
          }
        }
      }
    },
    "exercise.stationary-bike.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the resistance or cadence to your working pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la resistencia o la cadencia hasta tu ritmo de trabajo."
          }
        }
      }
    },
    "exercise.stationary-bike.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a steady rhythm for the planned time, then ease off gradually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un ritmo constante durante el tiempo previsto y disminuye gradualmente al final."
          }
        }
      }
    },
    "exercise.stationary-bike.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedaling a stationary bike at a chosen resistance. Low-impact cardio that mainly works the quads while sparing the joints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedalear en una bicicleta estática con la resistencia elegida. Cardio de bajo impacto que trabaja principalmente los cuádriceps y cuida las articulaciones."
          }
        }
      }
    },
    "exercise.treadmill-run.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start walking at an easy pace to warm up for a few minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza caminando a un ritmo suave para calentar durante unos minutos."
          }
        }
      }
    },
    "exercise.treadmill-run.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the speed to a run you can sustain for the planned time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la velocidad hasta un trote que puedas mantener durante el tiempo previsto."
          }
        }
      }
    },
    "exercise.treadmill-run.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run upright with a relaxed stride, landing under your hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre erguido con una zancada relajada, apoyando el pie bajo la cadera."
          }
        }
      }
    },
    "exercise.treadmill-run.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow to a walk for a few minutes before stopping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce a caminata unos minutos antes de detenerte."
          }
        }
      }
    },
    "exercise.treadmill-run.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady running on a treadmill. A full-body cardio staple for endurance and conditioning, with adjustable speed and incline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correr a ritmo constante en una caminadora. Un ejercicio cardiovascular básico de cuerpo completo para la resistencia, con velocidad e inclinación ajustables."
          }
        }
      }
    },
    "exercise.triceps-pushdown.step.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face a high pulley and grab the bar or rope with your elbows bent at your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócate frente a una polea alta y toma la barra o cuerda con los codos flexionados a los costados."
          }
        }
      }
    },
    "exercise.triceps-pushdown.step.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push the attachment down until your arms are fully extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja el accesorio hacia abajo hasta extender los brazos por completo."
          }
        }
      }
    },
    "exercise.triceps-pushdown.step.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squeeze your triceps at the bottom, keeping your elbows pinned in place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrae los tríceps abajo, manteniendo los codos fijos en su lugar."
          }
        }
      }
    },
    "exercise.triceps-pushdown.step.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the attachment rise slowly back to chest height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
